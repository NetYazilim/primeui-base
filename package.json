{
  "name": "primeui-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:unit": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@primeicons/vue": "^8.0.0",
    "@primeuix/themes": "^3.0.0",
    "primevue": "^5.0.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^5.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.7"
